{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mutant-family-triage-response.schema.json",
  "title": "RQ1 Selected Mutant Family Triage Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisions"],
  "properties": {
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mutant_id",
          "status",
          "rationale",
          "specification_reference",
          "observable_behavior",
          "trigger",
          "expected_result"
        ],
        "properties": {
          "mutant_id": { "type": "string", "minLength": 1 },
          "status": {
            "enum": ["eligible", "deferred", "suspected_equivalent", "out_of_scope"]
          },
          "rationale": { "type": "string", "minLength": 1 },
          "specification_reference": { "type": ["string", "null"] },
          "observable_behavior": { "type": ["string", "null"] },
          "trigger": { "type": ["string", "null"] },
          "expected_result": { "type": ["string", "null"] }
        }
      }
    }
  }
}
